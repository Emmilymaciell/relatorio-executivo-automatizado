# Manifesto de NOMES das variaveis de ambiente que os scripts leem.
# Valores reais NUNCA entram no Git: ficam no .env local (ignorado) ou no ambiente.
# Levantado do codigo em 2026-10-11 (Emmily AI Project OS, fase 8).

# --- SharePoint / Microsoft Graph (credenciais: segredo) ---
PROG_SP_TENANT_ID=
PROG_SP_CLIENT_ID=
PROG_SP_CLIENT_SECRET=
# (valor real só no .env local ou em %USERPROFILE%/.prog/sharepoint.env)
PROG_SP_CREDENCIAIS=
PROG_SP_CONFIG=

# --- Caminhos e parametros (nao sao segredo; opcionais) ---
PROG_ROOT=
PROG_PROJECT_DIR=
PROG_WORK_DIR=
PROG_DADOS=
PROG_PARAMS=
PROG_BASE_DOCX=
PROG_BASE_PART1_IN=
PROG_ENTREGA_CONFIG=
PROG_ENTREGA_LOGS=
PROG_ENTREGA_OUT=
PROG_MEDICAO_N=
PROG_PLANILHA_MEDICAO=
PROG_PAINEL_TEMPLATE=
PROG_REUNIOES_FONTE_PT=
PROG_REUNIOES_MESTRE=
PROG_REUNIOES_ORIENTACAO=
PROG_REUNIOES_SEM_PREVIA=
PROG_TIMELINE_PPTX=
PROG_TIMELINE_XLSX=
PROG_DRY_RUN=
PROG_USE_EXAMPLE_DATA=
